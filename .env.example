# Copy to .env (git-ignored) and fill in. Variables already set in your shell take precedence.
#
# Key for hosted OpenAI-compatible servers used by `fixgen specgen`.
# Either the generic name, or the provider's own (GEMINI_API_KEY, GROQ_API_KEY, OPENROUTER_API_KEY).
SPECGEN_API_KEY=
# GEMINI_API_KEY=

# Gateway session passwords referenced from config/gateway.json as ${...}
# DEMO_PASSWORD=
# ACME_PASSWORD=
